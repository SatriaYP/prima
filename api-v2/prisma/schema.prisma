generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enum untuk role dan status

model User {
  id          String    @id @default(uuid())
  username    String    @unique
  password    String
  email       String?   @unique
  name        String
  role        String    // "admin", "operator", "viewer"
  level       String    // "dpp", "dpw", "dpk"
  regionId    String?
  region      Region?   @relation(fields: [regionId], references: [id])
  status      String    @default("active") // "active", "inactive", "pending"
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  auditLogs   AuditLog[]
  members     Member[]  @relation("RegisteredBy")
}

model Member {
  id                String    @id @default(uuid())
  nik               String    @unique
  ktaNumber         String    @unique
  name              String
  gender            String    // "Laki-laki", "Perempuan"
  birthPlace        String?
  birthDate         DateTime?
  address           String?
  phone             String?
  email             String?   @unique
  maritalStatus     String?   // "Belum Kawin", "Kawin", "Cerai Hidup", "Cerai Mati"
  occupation        String?
  skills            String?
  interests         String?
  provinceCode        String?
  province          Region?   @relation("MemberProvince", fields: [provinceCode], references: [code])
  cityCode            String?
  city              Region?   @relation("MemberCity", fields: [cityCode], references: [code])
  districtCode        String?
  district          Region?   @relation("MemberDistrict", fields: [districtCode], references: [code])
  villageCode         String?
  village           Region?   @relation("MemberVillage", fields: [villageCode], references: [code])
  ktpUrl            String?   // URL to KTP image
  ktpProcessedUrl   String?   // URL to processed KTP image
  photoUrl          String?   // URL to member photo
  certificateUrl    String?   // URL to skill certificate
  registrationType  String    @default("admin") // "admin", "operator", "mandiri"
  registeredById    String?
  registeredBy      User?     @relation("RegisteredBy", fields: [registeredById], references: [id])
  isOfficial        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Official {
  id          String    @id @default(uuid())
  name        String
  position    String
  level       String    // "dpp", "dpw", "dpk"
  regionId    String?
  region      Region?   @relation(fields: [regionId], references: [id])
  email       String?
  phone       String?
  parentId    String?
  parent      Official? @relation("OfficialHierarchy", fields: [parentId], references: [id])
  children    Official[] @relation("OfficialHierarchy")
  sequence    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Region {
  id          String    @id @default(uuid())
  code        String    @unique // Kode Kemendagri
  name        String
  level       String    // "province", "city", "district", "village"
  parentId    String?
  parent      Region?   @relation("RegionHierarchy", fields: [parentId], references: [code])
  children    Region[]  @relation("RegionHierarchy")
  users       User[]
  officials   Official[]
  memberProvinces Member[] @relation("MemberProvince")
  memberCities    Member[] @relation("MemberCity")
  memberDistricts Member[] @relation("MemberDistrict")
  memberVillages  Member[] @relation("MemberVillage")
  liaisons    LiaisonOfficer[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model LiaisonOfficer {
  id          String    @id @default(uuid())
  name        String
  phone       String
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id])
  status      String    @default("active") // "active", "inactive"
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  action      String    // "create", "update", "delete", "login", "logout", etc.
  entityType  String    // "member", "official", "user", etc.
  entityId    String?
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
}
model Surat {
  id          String   @id @default(cuid())
  jenisSurat  String   // "undangan", "pemberitahuan", "tugas", "keterangan"
  judul       String?
  isi         Json     // 👈 Simpan semua data input sebagai JSON (fleksibel)
  tanggal     DateTime @default(now())
  status      String   @default("draft") // draft, published
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
